{
        servers {
                metrics

                # Trusts X-Forwarded-For; do not publish :3000 beyond 127.0.0.1.
                trusted_proxies static private_ranges
        }

        # Admin API has no authentication: keep it off the compose network.
        admin localhost:2019
}

:3000

# /var/log/caddy is a host bind mount (mkdir -p on first run); JSON is the
# format scripts/usage-report.sh parses.
log {
        output file /var/log/caddy/access.log {
                roll_size 20mb
                roll_keep 10
        }
        format json
}

route {
        # First in the route so the app's CSP below never reaches it: GoAccess
        # writes one self-contained HTML whose script and style are inline.
        # Served open, hence noindex. Empty bind mount before the first
        # usage-report.sh run, so 404 here means "no report yet".
        redir /stats /stats/
        handle_path /stats/* {
                header X-Robots-Tag noindex
                header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
                root * /srv/stats
                file_server {
                        index index.html
                }
        }

        header Strict-Transport-Security max-age=31536000
        header X-Content-Type-Options nosniff
        header Referrer-Policy strict-origin
        # style-src-elem 'unsafe-inline' is required by MantineProvider's
        # runtime <style>; a nonce is impossible behind a static file_server.
        header Content-Security-Policy "
                default-src 'self';
                script-src 'self';
                worker-src 'self' blob:;
                img-src 'self' data: blob: cache.kartverket.no;
                connect-src 'self' data: blob: *.geonorge.no *.norgeskart.no cache.kartverket.no hoydedata.no;
                style-src-elem 'self' 'unsafe-inline';
                style-src-attr 'unsafe-inline';
                font-src 'self';
                frame-ancestors 'self';
        "
        header Permissions-Policy "geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), accelerometer=(), camera=()"

        # Must stay a narrow redir: an SPA fallback here would answer every
        # wrong path with a 200.
        @shortLink path_regexp shortLink ^/l/([0-9A-Za-z]+)$
        redir @shortLink /?lok={re.shortLink.1}

        handle_path /wms/geonorge/* {
                rewrite * /skwms1{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        handle_path /wfs/geonorge/* {
                rewrite * /wfs-skwms1{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        handle_path /wms/ra/* {
                rewrite * /wms{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        handle_path /kms/* {
                rewrite * /kms-api{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        handle_path /wms/nib/* {
                rewrite * /nib-wms{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        handle_path /arcgis/nib/* {
                rewrite * /nib-arcgis{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        handle_path /arcgis/hoydedata/* {
                rewrite * /hoydedata-arcgis{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # /tiles, not /tms: a TMS request forces origin 'sw', flipping every
        # row, which renders as a blank map rather than a wrong one.
        # Port 80 is the 7.0.0 -nginx image's own; later tags moved it to 9090.
        @tileCache path_regexp tileCache ^/cache/([a-z0-9-]+)/(\d{1,2}/\d{1,7}/\d{1,7}\.(?:png|jpeg))$
        handle @tileCache {
                rewrite * /mapproxy/tiles/{re.tileCache.1}/tufteseid25833/{re.tileCache.2}
                reverse_proxy http://mapproxy:80
        }

        handle_path /cvat/* {
                reverse_proxy http://cvat-tiles:8080
        }

        handle_path /pb/* {
                reverse_proxy http://pocketbase:8090 {
                        flush_interval -1
                }
        }
}

root * /var/www
file_server
