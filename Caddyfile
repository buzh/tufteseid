{
        servers {
                metrics
        }
        admin :2019
}

:3000

route {
        header Strict-Transport-Security max-age=31536000
        header X-Content-Type-Options nosniff
        header Referrer-Policy strict-origin
        # The two style directives are split because they are two different
        # risks. `style-src-elem` allows inline <style> *elements*: MantineProvider
        # writes the theme's CSS variables into one at runtime, and it is not
        # optional — turning it off (`withCssVariables={false}`) means
        # transcribing Mantine's whole variable set into a stylesheet here and
        # re-transcribing it on every upgrade. A nonce is the stricter answer and
        # is not available: this is a static `file_server`, so there is no
        # per-request value to mint. `style-src-attr` allows inline style
        # *attributes*, which was already the case — React sets positions, sizes
        # and picked colours that way.
        header Content-Security-Policy "
                default-src 'self';
                script-src 'self';
                worker-src 'self' blob:;
                img-src 'self' data: blob: cache.kartverket.no;
                connect-src 'self' data: blob: *.geonorge.no *.norgeskart.no cache.kartverket.no hoydedata.no;
                style-src-elem 'self' 'unsafe-inline';
                style-src-attr 'unsafe-inline';
                font-src 'self';
                frame-ancestors 'self';
        "
        header Permissions-Policy "geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), accelerometer=(), camera=()"

        # /l/K7M2QX — the short URL for a lokalitet. A redirect to
        # /?lok=K7M2QX and nothing more: the code is the key, so there is
        # nothing to look up and no reason for this to be a service.
        #
        # Must stay a `redir` on this one narrow pattern, not an SPA fallback
        # over `file_server`: a catch-all rewrite to /index.html would turn
        # every wrong path in the app into a 200.
        #
        # One alphanumeric segment, not exactly six characters. A `{6}`
        # quantifier in a Caddyfile is a brace in a config format that reads
        # braces as structure, and the length check buys nothing anyway: the
        # app has to answer "no such lokalitet" for a well-formed code that
        # names nothing, which is the same message a malformed one gets.
        @shortLink path_regexp shortLink ^/l/([0-9A-Za-z]+)$
        redir @shortLink /?lok={re.shortLink.1}

        # Proxies to wmscache. One handler per upstream host — the second
        # path segment picks the host, the rest is passed through to that
        # host's WMS namespace. Layer configs use these same-origin paths
        # so no CSP whitelist entry is needed for the upstream and the
        # response can be cached by nginx.

        # wms.geonorge.no/skwms1/* — main Kartverket WMS namespace (theme
        # layers + national LiDAR + per-project LiDAR). handle_path strips
        # /wms/geonorge from the URI; the post-strip path already starts
        # with '/' so we prepend /skwms1 without another slash.
        handle_path /wms/geonorge/* {
                rewrite * /skwms1{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # wfs.geonorge.no/skwms1/* — Kartverket WFS namespace. One live
        # caller: the LiDAR project footprints (lidarFootprints.ts).
        # Distinct internal prefix so it can't be confused with
        # wms.geonorge.no's /skwms1/ in wmscache; nginx rewrites it back
        # to /skwms1/ before forwarding.
        handle_path /wfs/geonorge/* {
                rewrite * /wfs-skwms1{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # kart.ra.no/wms/* — Riksantikvaren Kulturminner WMS.
        handle_path /wms/ra/* {
                rewrite * /wms{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # kms-api.kulturminnesok.no/api/* — Kulturminnesøk's own record API.
        # Not a map source: the only thing asked of it is whether the
        # `linkkulturminnesok` URL Riksantikvaren serves on a feature will
        # actually resolve. Roughly a fifth to a third of the lokaliteter in
        # kart.ra.no's WMS are absent from Kulturminnesøk's index, and its
        # resolver answers a miss with a 200 and an all-null record rather
        # than a 404 — so the link looks fine and lands on a blank page.
        # Same-origin through wmscache because the API sends no CORS headers.
        handle_path /kms/* {
                rewrite * /kms-api{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # Norge i bilder ortofoto — same-origin via wmscache, which proxies
        # to the nib-proxy sidecar that injects NiB's anonymous access
        # token (see nginx/wms-cache.conf location /nib-wms/). No CSP entry
        # needed: the browser only ever talks to this origin.
        handle_path /wms/nib/* {
                rewrite * /nib-wms{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # Norge i bilder ArcGIS REST — the same sidecar and the same token,
        # but a different upstream namespace (/arcgis/rest/services). This
        # is how per-project ortofoto works: NiB exposes no WMS for single
        # acquisitions, so the lokalitet "Flyfoto" action enumerates them
        # via prosjekter/MapServer/4/query and renders one at a time via
        # ortofoto_prosjekter/ImageServer/exportImage. Same-origin as
        # everything else, so still no CSP entry.
        handle_path /arcgis/nib/* {
                rewrite * /nib-arcgis{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # hoydedata.no ArcGIS REST — Kartverket's elevation ImageServers.
        # Unlike /wms/geonorge/* (which serves Kartverket's *pre-shaded*
        # hillshade PNGs) this is where the raw float elevation grid comes
        # from: exportImage with renderingRule {"rasterFunction":"None"}
        # returns a 32-bit float GeoTIFF, which is what the lokalitet
        # terrain tool needs to compute its own relief visualizations.
        # See docs/terrain-analysis.md. Anonymous — no token sidecar, so
        # this goes straight to the host via wmscache.
        handle_path /arcgis/hoydedata/* {
                rewrite * /hoydedata-arcgis{http.request.uri.path}
                reverse_proxy http://wmscache
        }

        # The MapProxy caches: the six upstream layers whose parameters never
        # change, held as tiles on the app's own grid. `/cache/<layer>/z/x/y.png`
        # rather than MapProxy's TMS path, so the app asks for plain XYZ tiles
        # and the grid name and service version live in exactly one place.
        #
        # One regexp rather than six blocks, unlike the wmscache handlers above:
        # those pick between hosts, this is one service and one rewrite with the
        # layer name substituted. A `/cache/` name MapProxy does not publish
        # comes back 404 from MapProxy rather than being refused here, which is
        # the same answer and one less list to keep in step.
        #
        # :9090 and the /mapproxy prefix are the -nginx image's own: uwsgi
        # behind nginx, SCRIPT_NAME /mapproxy.
        @tileCache path_regexp tileCache ^/cache/([a-z0-9-]+)/(\d{1,2}/\d{1,7}/\d{1,7}\.(?:png|jpeg))$
        handle @tileCache {
                rewrite * /mapproxy/tms/1.0.0/{re.tileCache.1}/tufteseid25833/{re.tileCache.2}
                reverse_proxy http://mapproxy:9090
        }

        # The cached combined-VAT ground. One MBTiles database per LiDAR
        # acquisition, served a tile at a time by the cvat-tiles sidecar —
        # /cvat/<acquisition>/<z>/<x>/<y>.webp, and /cvat/manifest.json
        # beside it saying which acquisitions the store holds. Same URLs
        # the store answered when it was a bind-mounted tree of files under
        # Caddy's own root, which is why the app needs to know nothing
        # about the change. Inside the route block so it is matched before
        # `file_server`, which would otherwise answer /cvat/* out of
        # /var/www.
        handle_path /cvat/* {
                reverse_proxy http://cvat-tiles:8080
        }

        # PocketBase — backend for lokaliteter (auth + user content).
        # Kept same-origin so browser auth cookies "just work" and there's
        # no CORS to configure. The full OAuth2 redirect flow bounces
        # through /pb/api/oauth2-redirect on the SPA origin. Realtime
        # (Server-Sent Events) is a plain long-lived GET, no upgrade
        # needed — Caddy proxies it as-is.
        handle_path /pb/* {
                reverse_proxy http://pocketbase:8090 {
                        flush_interval -1
                }
        }
}

root * /var/www
file_server
