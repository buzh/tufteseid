# Copy to `.env` beside docker-compose.yml and fill in. Compose reads it
# automatically and refuses to start while a required key is empty.

# The address readers visit, no trailing slash.
PUBLIC_ORIGIN=https://example.org

# Casdoor's own hostname — bare, no scheme and no path, https assumed. Point
# it at the same place PUBLIC_ORIGIN goes; Caddy separates the two on the Host
# header (docs/identity.md).
CASDOOR_HOST=id.example.org


# --- Opt-in services ------------------------------------------------------
#
# Four sidecars are off unless named here. Each key does two things: it decides
# whether compose starts the container, and it is written into
# /var/www/services.js so the SPA hides the chips and toggles that would only
# ask a service nobody is running (docs/architecture.md).
#
# `true` exactly — anything else, blank included, reads as off on both sides.
# Leave this line as it is: it is what makes `enabled-true` an active profile
# and `enabled-false` an inactive one.
COMPOSE_PROFILES=enabled-true

# nib-proxy: Norge i bilder ortofoto. The Flyfoto ground, the archive walk and
# the flyfoto evidence kind. Needs no credentials — the sidecar mints NiB's
# anonymous token itself (docs/wms-proxy-and-tiles.md).
ENABLE_FLYFOTO=false

# cvat-tiles: the precomputed RVT ground, one MBTiles database per LiDAR
# acquisition under /site/tufteseid/data/cvat. Nothing to serve until
# `vat-cache/` has built one (vat-cache/README.md).
ENABLE_CVAT=false

# rendersvc: server-side sun loops and RVT blends. CPU-hungry; also gated per
# account by the `render` permission in Casdoor (docs/render-sidecar.md).
ENABLE_RENDER=false

# remark42: comment threads on public spots. Requires Casdoor, and the three
# REMARK42_* keys below (docs/discussion-and-votes.md).
ENABLE_TALK=false


# --- remark42 (only read when ENABLE_TALK=true) ---------------------------
#
# Blank is fine while the threads are off. With them on, a blank secret or a
# blank half of the OIDC pair stops the container at startup and says so in its
# own logs, not compose's.

# remark42's JWT signing key; changing it signs every reader out.
# `openssl rand -hex 32`
REMARK42_SECRET=

# The remark42 moderator, as the user id Casdoor reports in `sub`. Blank
# means no moderator.
REMARK42_ADMIN_ID=

# Unlocks remark42's `backup`, `restore` and `remap` subcommands. Basic auth
# on the public admin endpoints, so leave it blank except while running one.
REMARK42_ADMIN_PASSWD=

# From the remark42 application in Casdoor's console (docs/identity.md).
REMARK42_OIDC_CID=
REMARK42_OIDC_CSEC=
