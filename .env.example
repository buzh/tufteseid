# Copy to `.env` beside docker-compose.yml and fill in. Compose reads it
# automatically; `docker compose up` refuses to start while a required key is
# empty rather than bringing a service up half-configured.

# The address readers visit, no trailing slash. Casdoor composes its OIDC
# endpoints from it, remark42 its cookies and callback, and the render sidecar
# the short link burnt into a sun loop.
PUBLIC_ORIGIN=https://example.org

# remark42's JWT signing key. Any long hard-to-guess string; changing it signs
# every reader out. `openssl rand -hex 32`
REMARK42_SECRET=

# The remark42 admin, as the user id Casdoor reports in `sub`. Blank means no
# moderator, which is survivable on a quiet site and not much else.
REMARK42_ADMIN_ID=

# Unlocks remark42's `backup`, `restore` and `remap` subcommands. Leave blank
# unless you are running one: it is basic auth on the same public admin
# endpoints the widget moderates through, so a set password is a second way in
# that nothing rate-limits. Blank it again afterwards. Nothing is lost by
# turning it on late — comments keep their old keys until remap moves them.
REMARK42_ADMIN_PASSWD=

# Casdoor → Applications → the application you register for remark42. Its
# redirect URI must be exactly $PUBLIC_ORIGIN/remark42/auth/tufteseid/callback
# — `tufteseid` there is AUTH_CUSTOM_NAME in docker-compose.yml.
#
# Left as placeholders rather than blank on purpose. Compose interpolates the
# whole file before it starts anything, so a blank one here aborts
# `docker compose up` outright — including the Casdoor that would have minted
# them. With a placeholder remark42 starts and only the sign-in fails, which
# is the state you want while registering the application.
REMARK42_OIDC_CID=replace-after-registering-in-casdoor
REMARK42_OIDC_CSEC=replace-after-registering-in-casdoor
